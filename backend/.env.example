# Copy to backend/.env; preserve SECRET_KEY across restarts and deployments.
# Generate once: py -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DB_TYPE=sqlite
DB_NAME=volleyball_app.db
# Optional: both values are required to enable SMS.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# Must match the SMS signature and approved verification-code template in the Alibaba Cloud account.
ALIYUN_SMS_SIGN_NAME=
SMS_TEMPLATE_REGISTER=
VOLC_API_KEY=
